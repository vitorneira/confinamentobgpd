# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (config local, não versionar)
.claude/settings.local.json

# pacote de referência pessoal do dono (fora de dados_originais/, não faz parte do app)
/Arquivos consulta pessoal/
/Handoff*.html
/2020.04.CMR.*.png
/2020.04.CMR.*.zip

# corpus bruto de conversas do Orquestrador (nomes reais, texto não filtrado —
# nunca versionar). Só a amostra sanitizada em
# dados_originais/orquestrador_corpus/eval_set.json entra no git.
/dados_originais/orquestrador_corpus/*.zip
/dados_originais/orquestrador_corpus/_bruto/
/scripts/orquestrador/_amostra_candidata.json
